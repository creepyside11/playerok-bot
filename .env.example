BOT_TOKEN=123456789:replace_me
PORT=3000
MINI_APP_URL=https://playerok-bot.bothost.tech

# Optional: внешний PostgreSQL. Для Bothost укажите выданный хостингом URL;
# localhost работает только если PostgreSQL запущен в том же окружении.
# DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/playerok

# Optional
# POLL_INTERVAL=6
# LOG_LEVEL=INFO
# Telegram Accounts: use the plugin settings or specify your own Telegram API credentials here.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
